<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Packages produced by Make/build.cs -->
    <add key="NDO-BuiltPackages" value="BuiltPackages" />
  </packageSources>
  <disabledPackageSources>
    <!-- User-level source pointing to an outdated copy of BuiltPackages -->
    <add key="NDO" value="true" />
  </disabledPackageSources>
</configuration>
