<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>StressTest</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="ndo.build" Version="6.1.0" />
		<PackageReference Include="ndo.dll" Version="6.0.0" />
		<PackageReference Include="NDO.Sqlite" Version="6.0.0" />
		<PackageReference Include="NDO.SqlServer" Version="6.0.0" />
		<PackageReference Include="NDO.Postgre" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\StressTestClasses\StressTestClasses.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\StressTestClasses\NDOMapping.xml" Link="StressTestClasses.NDOMapping.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
