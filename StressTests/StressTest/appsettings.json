{
  // All values can be overridden on the command line, e.g.
  //   dotnet run -- --provider Postgre --threads 100 --iterations 20
  // or with environment variables with the prefix NDOSTRESS_, e.g.
  //   NDOSTRESS_ConnectionStrings__Postgre="Host=db;Database=ndostress;Username=ndo;Password=secret"
  "StressTest": {
    // Name of the NDO provider: Sqlite, SqlServer, MySql, MySqlConnector, Postgre
    "Provider": "SqlServer",
    // Overrides the connection string from the ConnectionStrings section
    "ConnectionString": "",
    // Number of concurrent workers. Each worker uses its own PersistenceManager instances.
    "Threads": 32,
    // Number of iterations per worker (create, change, verify, delete). Ignored if DurationSeconds > 0.
    "Iterations": 25,
    // If > 0, the workers run until the time is elapsed.
    "DurationSeconds": 0,
    "LinesPerOrder": 5,
    "TagCount": 8,
    // Optimistic or Pessimistic
    "TransactionMode": "Optimistic",
    // ReadCommitted, Serializable, ... Empty: NDO default (ReadCommitted), for Sqlite: Serializable
    "IsolationLevel": null,
    // true: all PersistenceManagers share one NDOMapping object, false: each PersistenceManager loads its own mapping
    "SharedMapping": true,
    // Drops and creates the tables before the test
    "RecreateSchema": true,
    // Drops the tables after a successful test
    "DropSchemaAfterTest": false,
    "StopOnFirstError": false,
    "MaxErrorsToPrint": 20,
    "ProgressIntervalSeconds": 5
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=ndo-stresstest.db;Journal Mode=Wal;Default Timeout=60;Pooling=True",
    "SqlServer": "Data Source=localhost;Initial Catalog=NDOStressTest;Integrated Security=True;TrustServerCertificate=True;Max Pool Size=500",
    "MySql": "Server=localhost;Database=ndostresstest;Uid=root;Pwd=;Max Pool Size=500",
    "MySqlConnector": "Server=localhost;Database=ndostresstest;Uid=root;Pwd=;Maximum Pool Size=500",
    "Postgre": "Host=localhost;Database=ndostresstest;Username=postgres;Password=postgres;Maximum Pool Size=500"
  }
}
